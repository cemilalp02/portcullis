<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="Portcullis {{.Version}}">
<meta name="color-scheme" content="light dark">
<title>{{.Name}} · Portcullis inspection report</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
<style>{{.CSS}}</style>
</head>
<body>
<svg class="absolute size-0 overflow-hidden" aria-hidden="true" focusable="false">{{.Icons}}</svg>

<header class="mx-auto max-w-[1240px] px-5 sm:px-8">
  <div class="flex h-16 items-center gap-4">
    <a class="flex items-center gap-2.5 text-foreground no-underline" href="#overview" aria-label="Portcullis">
      <svg class="h-[22px] w-[26px]" viewBox="6 10 52 44" aria-hidden="true"><path class="fill-current" d="{{.MarkLines}}"/><path class="fill-signal" d="{{.MarkChar}}"/></svg>
      <span class="text-[19px] font-semibold tracking-[-0.015em]">portcullis</span>
    </a>
    <span class="hidden text-sm text-muted-foreground sm:inline">Agent context inspection report</span>
    <span class="flex-1"></span>
    <span class="hidden font-mono text-xs text-muted-foreground md:inline">{{.Version}}</span>
    <button class="inline-flex size-8 items-center justify-center border border-rule text-muted-foreground transition-colors hover:border-rule-strong hover:text-foreground print:hidden" id="theme" type="button" aria-label="Switch between light and dark theme" title="Switch theme" hidden>
      <svg class="size-4 dark:hidden" aria-hidden="true"><use href="#i-moon"/></svg><svg class="hidden size-4 dark:block" aria-hidden="true"><use href="#i-sun"/></svg>
    </button>
  </div>
  <div class="h-[3px] bg-rule-strong"></div>
</header>

<div class="mx-auto max-w-[1240px] px-5 sm:px-8 lg:grid lg:grid-cols-[176px_minmax(0,1fr)] lg:gap-14">
  <aside class="hidden lg:block print:hidden">
    <nav class="sticky top-0 pt-10" aria-label="Contents">
      <p class="label text-faint">Contents</p>
      <ol class="mt-3 border-t border-rule text-sm">
        <li><a class="flex items-baseline gap-3 border-b border-rule py-2 text-muted-foreground no-underline transition-[padding] hover:text-foreground aria-[current=true]:pl-2.5 aria-[current=true]:text-foreground aria-[current=true]:shadow-[inset_2px_0_0_var(--foreground)]" href="#overview" data-nav aria-current="true"><span class="font-mono text-xs text-faint">01</span>Summary</a></li>
        <li><a class="flex items-baseline gap-3 border-b border-rule py-2 text-muted-foreground no-underline transition-[padding] hover:text-foreground aria-[current=true]:pl-2.5 aria-[current=true]:text-foreground aria-[current=true]:shadow-[inset_2px_0_0_var(--foreground)]" href="#findings" data-nav><span class="font-mono text-xs text-faint">02</span>Findings<span class="ml-auto font-mono text-xs">{{num .Total}}</span></a></li>
        <li><a class="flex items-baseline gap-3 border-b border-rule py-2 text-muted-foreground no-underline transition-[padding] hover:text-foreground aria-[current=true]:pl-2.5 aria-[current=true]:text-foreground aria-[current=true]:shadow-[inset_2px_0_0_var(--foreground)]" href="#inventory" data-nav><span class="font-mono text-xs text-faint">03</span>Runs unasked<span class="ml-auto font-mono text-xs">{{len .Inventory}}</span></a></li>
        <li><a class="flex items-baseline gap-3 border-b border-rule py-2 text-muted-foreground no-underline transition-[padding] hover:text-foreground aria-[current=true]:pl-2.5 aria-[current=true]:text-foreground aria-[current=true]:shadow-[inset_2px_0_0_var(--foreground)]" href="#files" data-nav><span class="font-mono text-xs text-faint">04</span>Agent files<span class="ml-auto font-mono text-xs">{{num (len .TargetFiles)}}</span></a></li>
        {{- if .Rules}}
        <li><a class="flex items-baseline gap-3 border-b border-rule py-2 text-muted-foreground no-underline transition-[padding] hover:text-foreground aria-[current=true]:pl-2.5 aria-[current=true]:text-foreground aria-[current=true]:shadow-[inset_2px_0_0_var(--foreground)]" href="#rules" data-nav><span class="font-mono text-xs text-faint">05</span>Rules<span class="ml-auto font-mono text-xs">{{len .Rules}}</span></a></li>
        {{- end}}
      </ol>
      <p class="label mt-10 text-faint">Inspection</p>
      <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 border-t border-rule pt-3 text-xs">
        <dt class="text-muted-foreground">Mode</dt><dd class="text-right font-mono">{{.Mode}}</dd>
        <dt class="text-muted-foreground">Threshold</dt><dd class="text-right font-mono">{{.Threshold}}</dd>
        <dt class="text-muted-foreground">Exit code</dt><dd class="text-right font-mono">{{.ExitCode}}</dd>
        <dt class="text-muted-foreground">Rule set</dt><dd class="text-right font-mono">{{.Ruleset}}</dd>
      </dl>
    </nav>
  </aside>

  <main class="min-w-0 pb-20">
    <section class="scroll-mt-6 pt-10" id="overview" aria-labelledby="h-repo">
      <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
        <div class="min-w-0">
          <p class="label text-faint">Repository</p>
          <h1 class="mt-2 break-words text-[40px] font-semibold leading-[1.1] tracking-[-0.025em] sm:text-[48px]" id="h-repo">{{.Name}}</h1>
          <p class="mt-4 max-w-[560px] text-[15px] leading-relaxed text-muted-foreground">{{.Summary}}</p>
        </div>
        <div class="st-{{.Status}} w-full shrink-0 border-2 border-(--st) p-1 md:w-[300px]" data-verdict="{{.Status}}" data-exit="{{.ExitCode}}" data-threshold="{{.Threshold}}">
          <div class="border border-(--st)/60 px-5 py-4">
            <p class="font-mono text-[26px] font-medium leading-none tracking-[0.18em] text-(--st)">{{.StatusLabel}}</p>
            <p class="mt-3 text-[15px] font-semibold leading-snug" data-headline>{{.Headline}}</p>
            <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 border-t border-(--st)/30 pt-3 font-mono text-xs text-muted-foreground"><span>exit {{.ExitCode}}</span><span>threshold {{.Threshold}}</span>{{if .Suppressed}}<span>{{.Suppressed}} suppressed by baseline</span>{{end}}</p>
          </div>
        </div>
      </div>

      {{- if .Errors}}
      <div class="mt-8 border-l-[3px] border-(--crit) bg-surface px-5 py-4 text-sm" role="alert">
        <p class="label text-(--crit)">Analysis incomplete</p>
        <p class="mt-1.5">These files could not be analysed, so this result must not be treated as clean:</p>
        <ul class="mt-2 space-y-0.5 font-mono text-xs">{{range .Errors}}<li class="break-all">{{.}}</li>{{end}}</ul>
      </div>
      {{- end}}

      <div class="mt-12 flex items-baseline gap-4 border-b border-rule-strong pb-2">
        <span class="font-mono text-sm text-signal">01</span><h2 class="text-[22px] font-semibold tracking-[-0.01em]">Summary</h2>
        <span class="ml-auto font-mono text-xs text-muted-foreground">{{num .Total}} {{plural .Total "finding" "findings"}}</span>
      </div>
      <div class="grid grid-cols-2 border-b border-rule sm:grid-cols-5" role="list" aria-label="Findings by severity">
        {{- range .Counts}}
        <a class="sev-{{.Key}} group border-rule px-4 py-5 no-underline transition-colors hover:bg-hover max-sm:odd:not-last:border-r max-sm:[&:nth-child(-n+4)]:border-b max-sm:last:col-span-2 sm:border-r sm:last:border-r-0{{if .N}} text-foreground{{else}} text-faint{{end}}" href="#findings" data-filter="{{.Key}}" role="listitem">
          <span class="flex items-center gap-2"><span class="size-2.5 bg-(--sev)"></span><span class="label text-muted-foreground">{{.Label}}</span></span>
          <span class="mt-3 block font-mono text-[34px] font-medium leading-none tabular-nums tracking-[-0.02em]">{{num .N}}</span>
          <span class="mt-2 block text-xs text-muted-foreground">{{if .N}}{{.Pct}}% of findings{{else}}none{{end}}</span>
        </a>
        {{- end}}
      </div>
      <svg class="mt-4 block h-2 w-full" viewBox="0 0 1000 8" preserveAspectRatio="none" role="img" aria-label="{{.DistLabel}}">
        {{- range .Dist}}<rect class="sev-{{.Key}} fill-(--sev)" x="{{.X}}" y="0" width="{{.W}}" height="8"/>{{end -}}
      </svg>

      <div class="mt-12 grid grid-cols-1 gap-x-10 gap-y-10 xl:grid-cols-3">
        <div>
          <p class="label border-b border-rule-strong pb-2">Rules most triggered</p>
          {{- if .TopRules}}
          <ol class="text-sm">
            {{- range .TopRules}}
            <li class="sev-{{.SevKey}} border-b border-rule py-2.5">
              <div class="flex items-baseline gap-3"><span class="shrink-0 font-mono text-xs text-muted-foreground">{{.ID}}</span><span class="min-w-0 flex-1 truncate">{{.Title}}</span><span class="font-mono text-xs tabular-nums">{{.Count}}</span></div>
              <svg class="mt-2 block h-[3px] w-full" viewBox="0 0 1000 3" preserveAspectRatio="none" aria-hidden="true"><rect class="fill-(--sev)" width="{{.W}}" height="3"/></svg>
            </li>
            {{- end}}
          </ol>
          {{- else}}
          <p class="border-b border-rule py-3 text-sm text-muted-foreground">No rule matched.</p>
          {{- end}}
        </div>
        <div>
          <p class="label border-b border-rule-strong pb-2">Files with the most findings</p>
          {{- if .TopFiles}}
          <ol class="text-sm">
            {{- range .TopFiles}}
            <li class="flex items-center gap-3 border-b border-rule py-2.5">
              <span class="min-w-0 flex-1 truncate font-mono text-xs" title="{{.Path}}">{{.Path}}</span>
              <span class="flex shrink-0 gap-1">{{range .Tally}}<span class="sev-{{.Key}} size-2 bg-(--sev)" title="{{.N}} {{.Key}}"></span>{{end}}</span>
              <span class="w-6 shrink-0 text-right font-mono text-xs tabular-nums">{{.Count}}</span>
            </li>
            {{- end}}
          </ol>
          {{- else}}
          <p class="border-b border-rule py-3 text-sm text-muted-foreground">No file has findings.</p>
          {{- end}}
        </div>
        <div>
          <p class="label border-b border-rule-strong pb-2">Runs without asking</p>
          {{- if .AutoRun}}
          <ol class="text-sm">
            {{- range .AutoRun}}
            <li class="flex items-baseline gap-3 border-b border-rule py-2.5"><span class="min-w-0 flex-1">{{.Label}}</span><span class="font-mono text-xs tabular-nums">{{.N}}</span></li>
            {{- end}}
          </ol>
          <a class="mt-3 inline-block text-sm text-foreground underline decoration-rule hover:decoration-foreground" href="#inventory">Every command, in section 03</a>
          {{- else}}
          <p class="border-b border-rule py-3 text-sm text-muted-foreground">Nothing runs automatically.</p>
          {{- end}}
        </div>
      </div>
    </section>

    <section class="mt-16 scroll-mt-6" id="findings" aria-labelledby="h-findings">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2 border-b border-rule-strong pb-2">
        <span class="font-mono text-sm text-signal">02</span><h2 class="text-[22px] font-semibold tracking-[-0.01em]" id="h-findings">Findings</h2>
        <span class="font-mono text-xs text-muted-foreground" id="findings-count" data-total="{{.Total}}">{{.Total}}</span>
        {{- if .Groups}}<button class="ml-auto text-sm text-muted-foreground underline decoration-rule hover:text-foreground hover:decoration-foreground print:hidden" id="toggle-all" type="button" hidden>Expand all</button>{{end}}
      </div>
      <p class="mt-3 max-w-[640px] text-sm text-muted-foreground">Grouped by file, most severe first. Findings at or above the threshold are open and marked with a line.</p>
      {{- if .Groups}}
      <div class="mt-6 flex flex-col gap-4 md:flex-row md:items-center md:justify-between print:hidden">
        <div class="flex flex-wrap gap-x-5 gap-y-2" role="group" aria-label="Filter findings by severity">
          {{- range .Counts}}
          <button class="chip sev-{{.Key}}{{if not .N}} zero{{end}} inline-flex items-center gap-2 border-b-2 border-transparent pb-1 text-sm text-muted-foreground transition-colors hover:text-foreground disabled:cursor-default disabled:opacity-40 aria-pressed:border-(--sev) aria-pressed:text-foreground" type="button" data-sev="{{.Key}}" aria-pressed="true" disabled><span class="size-2 bg-(--sev)"></span>{{.Label}}<span class="font-mono text-xs tabular-nums text-muted-foreground">{{num .N}}</span></button>
          {{- end}}
        </div>
        <label class="relative flex w-full items-center md:w-72" id="search-box" hidden>
          <svg class="pointer-events-none absolute left-0 size-4 text-muted-foreground" aria-hidden="true"><use href="#i-search"/></svg>
          <input class="h-9 w-full border-0 border-b border-rule bg-transparent pl-6 pr-8 text-sm outline-none transition-colors placeholder:text-faint focus-visible:border-foreground focus-visible:outline-none" id="search" type="search" placeholder="Filter by rule, file or text" aria-label="Filter findings" autocomplete="off" spellcheck="false">
          <kbd class="pointer-events-none absolute right-0 border border-rule px-1.5 font-mono text-[10px] leading-4 text-muted-foreground">/</kbd>
        </label>
      </div>
      {{- else}}
      <div class="mt-6 border-l-[3px] border-(--pass) bg-surface px-5 py-5">
        <p class="label text-(--pass)">No findings</p>
        <p class="mt-1.5 text-sm">Every agent context file was analysed and nothing matched a rule.</p>
      </div>
      {{- end}}
      <p class="mt-6 border-y border-rule py-6 text-center text-sm text-muted-foreground" id="no-match" hidden>No findings match the current filter.</p>
      {{- range .Groups}}
      <div class="file mt-10" data-file="{{.Path}}">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-rule-strong pb-2">
          <span class="min-w-0 break-all font-mono text-[15px] font-medium">{{.Path}}</span>
          {{- if .Kind}}<span class="label text-faint" data-kind>{{.Kind}}</span>{{end}}
          <span class="ml-auto flex flex-wrap gap-x-4">{{range .Tally}}<span class="sev-{{.Key}} inline-flex items-center gap-1.5 font-mono text-xs text-muted-foreground" data-tally="{{.Key}}"><span class="size-2 bg-(--sev)"></span>{{.N}} {{.Key}}</span>{{end}}</span>
        </div>
        {{- range .Findings}}
        <details class="finding group sev-{{.SevKey}} border-b border-rule{{if .Above}} shadow-[inset_3px_0_0_var(--sev)]{{end}}" data-sev="{{.SevKey}}" data-above="{{.Above}}" data-text="{{.Text}}"{{if .Above}} open{{end}}>
          <summary class="grid cursor-pointer grid-cols-[minmax(0,1fr)_auto] gap-x-6 gap-y-1 py-4 pl-5 pr-1 transition-colors hover:bg-hover sm:grid-cols-[96px_minmax(0,1fr)_auto]">
            <span class="label hidden pt-[3px] text-(--sev) sm:block">{{.SevKey}}</span>
            <span class="min-w-0">
              <span class="block text-[15px] font-semibold leading-6">{{.Title}}</span>
              <span class="mt-0.5 block break-words text-sm text-muted-foreground">{{.Message}}</span>
            </span>
            <span class="flex items-start gap-3 pt-[3px] font-mono text-xs text-muted-foreground"><span class="hidden text-right md:block">{{.RuleID}}<br>{{.Line}}:{{.Column}}</span><svg class="mt-px size-4 shrink-0 transition-transform group-open:rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg></span>
            <span class="label text-(--sev) sm:hidden">{{.SevKey}} <span class="font-mono font-normal normal-case tracking-normal text-muted-foreground">{{.RuleID}} · {{.Line}}:{{.Column}}</span></span>
          </summary>
          <div class="space-y-4 pb-6 pl-5 pr-1 sm:pl-[121px]">
            {{- if .Excerpt}}
            <pre class="flex overflow-x-auto border border-rule bg-surface font-mono text-[13px] leading-6"><span class="select-none border-r border-rule px-3 py-2 text-right text-faint">{{.Line}}</span><code class="min-w-0 flex-1 whitespace-pre-wrap break-all px-4 py-2">{{range .Spans}}{{if .Hidden}}<mark class="mx-0.5 border border-signal bg-transparent px-1 text-signal" title="{{.Title}}">{{.Text}}{{if .More}}<span class="ml-1.5 font-sans text-[11px] font-semibold">+{{.More}} more</span>{{end}}</mark>{{else}}{{.Text}}{{end}}{{end}}</code></pre>
            {{- end}}
            <div class="grid gap-1 sm:grid-cols-[88px_minmax(0,1fr)] sm:gap-4"><p class="label pt-[3px] text-muted-foreground">Remedy</p><p class="text-sm leading-relaxed">{{.Remediation}}</p></div>
            <dl class="grid gap-x-6 gap-y-1.5 text-xs sm:grid-cols-[88px_minmax(0,1fr)]">
              <dt class="label text-muted-foreground">Details</dt>
              <dd class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-muted-foreground">
                <span>confidence <b class="font-medium text-foreground">{{.Confidence}}</b></span>
                {{- if .OWASP}}<span>OWASP{{range .OWASP}} <b class="font-mono font-medium text-foreground">{{.}}</b>{{end}}</span>{{end}}
                <span class="inline-flex items-center gap-1">fingerprint <span class="fp font-mono text-foreground">{{.Fingerprint}}</span><button class="copy inline-flex size-6 items-center justify-center text-muted-foreground hover:text-foreground" type="button" data-copy="{{.Fingerprint}}" aria-label="Copy fingerprint" title="Copy fingerprint" hidden><svg class="size-3.5 [.done_&]:hidden" aria-hidden="true"><use href="#i-copy"/></svg><svg class="hidden size-3.5 text-(--pass) [.done_&]:block" aria-hidden="true"><use href="#i-check"/></svg></button></span>
                {{- if .DocURL}}<a class="inline-flex items-center gap-1 text-foreground underline decoration-rule hover:decoration-foreground" href="{{.DocURL}}" rel="noreferrer noopener" target="_blank">{{.RuleID}} documentation<svg class="size-3" aria-hidden="true"><use href="#i-arrow-up-right"/></svg></a>{{end}}
              </dd>
            </dl>
          </div>
        </details>
        {{- end}}
      </div>
      {{- end}}
    </section>

    <section class="mt-16 scroll-mt-6" id="inventory" aria-labelledby="h-inventory">
      <div class="flex items-baseline gap-4 border-b border-rule-strong pb-2">
        <span class="font-mono text-sm text-signal">03</span><h2 class="text-[22px] font-semibold tracking-[-0.01em]" id="h-inventory">Runs without asking</h2>
        <span class="font-mono text-xs text-muted-foreground">{{len .Inventory}}</span>
      </div>
      <p class="mt-3 max-w-[640px] text-sm text-muted-foreground">Commands that agents, editors or package managers start on their own: hooks, tasks, install scripts and MCP servers.</p>
      {{- if .Inventory}}
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-left"><tr class="border-b border-rule"><th class="label py-2 pr-6 text-muted-foreground">Trigger</th><th class="label py-2 pr-6 text-muted-foreground">Source</th><th class="label py-2 pr-6 text-muted-foreground">Name</th><th class="label py-2 pr-6 text-muted-foreground">Location</th><th class="label py-2 text-muted-foreground">Command</th></tr></thead>
          <tbody>
          {{- range .Inventory}}
            <tr class="border-b border-rule align-top"><td class="whitespace-nowrap py-3 pr-6 font-mono text-xs font-medium">{{.Trigger}}</td><td class="whitespace-nowrap py-3 pr-6 font-mono text-xs text-muted-foreground">{{.Kind}}</td><td class="py-3 pr-6 font-mono text-xs">{{if .Name}}{{.Name}}{{else}}<span class="text-faint">—</span>{{end}}</td><td class="whitespace-nowrap py-3 pr-6 font-mono text-xs text-muted-foreground">{{.Path}}:{{.Line}}</td><td class="py-3"><code class="block min-w-[240px] whitespace-pre-wrap break-all border-l-2 border-rule-strong bg-surface px-3 py-1.5 font-mono text-xs">{{.Command}}</code></td></tr>
          {{- end}}
          </tbody>
        </table>
      </div>
      {{- else}}
      <p class="mt-5 border-b border-rule py-3 text-sm text-muted-foreground">Nothing in this repository runs automatically.</p>
      {{- end}}
    </section>

    <section class="mt-16 scroll-mt-6" id="files" aria-labelledby="h-files">
      <div class="flex items-baseline gap-4 border-b border-rule-strong pb-2">
        <span class="font-mono text-sm text-signal">04</span><h2 class="text-[22px] font-semibold tracking-[-0.01em]" id="h-files">Agent context files</h2>
        <span class="font-mono text-xs text-muted-foreground">{{num (len .TargetFiles)}}</span>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">Every file an agent reads or runs that was inspected.</p>
      {{- if .TargetFiles}}
      {{- if .FoldFiles}}
      <details class="fold group/fold mt-5" data-fold>
        <summary class="inline-flex cursor-pointer items-center gap-1.5 text-sm underline decoration-rule hover:decoration-foreground"><svg class="size-3.5 transition-transform group-open/fold:rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg><span class="group-open/fold:hidden">Show all {{num (len .TargetFiles)}} files</span><span class="hidden group-open/fold:inline">Hide the file list</span></summary>
      {{- end}}
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-left"><tr class="border-b border-rule"><th class="label py-2 pr-6 text-muted-foreground">File</th><th class="label py-2 pr-6 text-muted-foreground">Type</th><th class="label py-2 text-right text-muted-foreground">Findings</th></tr></thead>
          <tbody>
          {{- range .TargetFiles}}
            <tr class="border-b border-rule"><td class="break-all py-2.5 pr-6 font-mono text-xs">{{.Path}}</td><td class="py-2.5 pr-6 text-muted-foreground">{{.Kind}}</td><td class="py-2.5 text-right">{{if .Findings}}<span class="inline-flex items-center gap-2"><span class="flex gap-1">{{range .Severities}}<span class="sev-{{.}} size-2 bg-(--sev)"></span>{{end}}</span><span class="font-mono text-xs tabular-nums">{{.Findings}}</span></span>{{else}}<span class="font-mono text-xs text-faint">0</span>{{end}}</td></tr>
          {{- end}}
          </tbody>
        </table>
      </div>
      {{- if .FoldFiles}}
      </details>
      {{- end}}
      {{- else}}
      <p class="mt-5 border-b border-rule py-3 text-sm text-muted-foreground">No agent context files were found.</p>
      {{- end}}
    </section>

    {{- if .Rules}}
    <section class="mt-16 scroll-mt-6" id="rules" aria-labelledby="h-rules">
      <div class="flex items-baseline gap-4 border-b border-rule-strong pb-2">
        <span class="font-mono text-sm text-signal">05</span><h2 class="text-[22px] font-semibold tracking-[-0.01em]" id="h-rules">Rules triggered</h2>
        <span class="font-mono text-xs text-muted-foreground">{{len .Rules}}</span>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">Each rule's documentation explains what it detects and why it matters.</p>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-left"><tr class="border-b border-rule"><th class="label py-2 pr-6 text-muted-foreground">Rule</th><th class="label py-2 pr-6 text-muted-foreground">Title</th><th class="label py-2 pr-6 text-muted-foreground">Severity</th><th class="label py-2 text-right text-muted-foreground">Findings</th></tr></thead>
          <tbody>
          {{- range .Rules}}
            <tr class="sev-{{.SevKey}} border-b border-rule"><td class="whitespace-nowrap py-2.5 pr-6 font-mono text-xs">{{if .DocURL}}<a class="text-foreground underline decoration-rule hover:decoration-foreground" href="{{.DocURL}}" rel="noreferrer noopener" target="_blank">{{.ID}}</a>{{else}}{{.ID}}{{end}}</td><td class="py-2.5 pr-6">{{.Title}}</td><td class="py-2.5 pr-6"><span class="label inline-flex items-center gap-2 text-(--sev)"><span class="size-2 bg-(--sev)"></span>{{.SevKey}}</span></td><td class="py-2.5 text-right font-mono text-xs tabular-nums">{{.Count}}</td></tr>
          {{- end}}
          </tbody>
        </table>
      </div>
    </section>
    {{- end}}
  </main>
</div>

<footer class="mx-auto max-w-[1240px] px-5 pb-12 sm:px-8">
  <div class="h-[3px] bg-rule-strong"></div>
  <div class="flex flex-col gap-4 pt-5 text-xs text-muted-foreground sm:flex-row sm:gap-10">
    <div class="flex items-center gap-2 text-sm font-semibold text-foreground"><svg class="h-[14px] w-[17px]" viewBox="6 10 52 44" aria-hidden="true"><path class="fill-current" d="{{.MarkLines}}"/><path class="fill-signal" d="{{.MarkChar}}"/></svg>portcullis</div>
    <div class="space-y-1.5 sm:ml-auto sm:max-w-[640px] sm:text-right">
      <p>Generated offline by Portcullis {{.Version}} with rule set {{.Ruleset}}. This report loads nothing from the network; text taken from scanned files is escaped and cannot run.</p>
      <p>Portcullis detects known patterns and structures. A report without findings lowers the risk; it does not prove that a repository is safe.</p>
    </div>
  </div>
</footer>
<script>{{.JS}}</script>
</body>
</html>
