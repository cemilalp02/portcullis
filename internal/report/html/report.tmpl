<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<meta name="referrer" content="no-referrer">
<meta name="generator" content="Portcullis {{.Version}}">
<meta name="color-scheme" content="light dark">
<title>{{.Name}} · Portcullis report</title>
<link rel="icon" type="image/svg+xml" href="{{.Favicon}}">
<style>{{.CSS}}</style>
</head>
<body>
<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-chev" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5 10.5 8 6 12.5"/></symbol>
  <symbol id="i-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8.5" height="8.5" rx="1.6"/><path d="M10.5 3.3V3A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.3"/></symbol>
  <symbol id="i-check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 8.5 3.2 3.2L13 4.8"/></symbol>
  <symbol id="i-ext" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5h6v6M12.5 3.5 4 12"/></symbol>
  <symbol id="i-search" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="7" cy="7" r="4.6"/><path d="m10.5 10.5 3.6 3.6"/></symbol>
  <symbol id="i-sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1.4v1.3M8 13.3v1.3M1.4 8h1.3M13.3 8h1.3M3.3 3.3l.9.9M11.8 11.8l.9.9M3.3 12.7l.9-.9M11.8 4.2l.9-.9"/></symbol>
  <symbol id="i-moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M13.6 9.7A5.9 5.9 0 0 1 6.3 2.4a5.9 5.9 0 1 0 7.3 7.3Z"/></symbol>
  <symbol id="i-fail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M7.5 7.5l9 9M16.5 7.5l-9 9"/></symbol>
  <symbol id="i-pass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5.8 12.6 4 4L18.4 8"/></symbol>
  <symbol id="i-warn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 6.5v7.2M12 17.6v.1"/></symbol>
  <symbol id="i-alert" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.9 14.6 13.6H1.4Z"/><path d="M8 6.4v3.2M8 11.7v.1"/></symbol>
  <symbol id="i-ok" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.3"/><path d="m5.3 8.2 1.9 1.9 3.6-3.8"/></symbol>
  <symbol id="mark" viewBox="0 0 64 64"><path d="{{.MarkPath}}"/></symbol>
</svg>

<header class="mast" id="top">
  <div class="mast-bar"><div class="wrap mast-top">
    <a class="brand" href="#top"><svg aria-hidden="true"><use href="#mark"/></svg>Portcullis</a>
    <span class="doc">Agent context scan report</span>
    <span class="spacer"></span>
    <span class="meta"><span>{{.Version}}</span><span>rules {{.Ruleset}}</span><span>{{.Mode}}</span></span>
    <button class="icon-btn" id="theme" type="button" aria-label="Switch between light and dark theme" title="Switch theme" hidden>
      <svg class="i i-sun" aria-hidden="true"><use href="#i-sun"/></svg><svg class="i i-moon" aria-hidden="true"><use href="#i-moon"/></svg>
    </button>
  </div></div>
  <div class="wrap hero">
    <div>
      <p class="eyebrow">Repository</p>
      <h1>{{.Name}}</h1>
      <p class="scope"><span>{{num .Targets}} agent context {{plural .Targets "file" "files"}} in {{num .Files}} {{plural .Files "file" "files"}}</span><span>{{.Mode}} mode</span></p>
    </div>
    <div class="verdict v-{{.Status}}">
      <span class="v-badge"><svg aria-hidden="true"><use href="#{{.StatusIcon}}"/></svg></span>
      <span class="v-label">{{.StatusLabel}}</span>
      <p class="v-text">{{.Headline}}</p>
      <p class="v-sub"><span>exit code {{.ExitCode}}</span><span>threshold {{.Threshold}}</span>{{if .Suppressed}}<span>{{.Suppressed}} suppressed by baseline</span>{{end}}</p>
    </div>
  </div>
  <nav class="wrap tabs" aria-label="Sections">
    <a href="#findings">Findings<span>{{num .Total}}</span></a>
    <a href="#inventory">Runs without asking<span>{{len .Inventory}}</span></a>
    <a href="#files">Agent context files<span>{{num (len .TargetFiles)}}</span></a>
    {{- if .Rules}}<a href="#rules">Rules<span>{{len .Rules}}</span></a>{{end}}
  </nav>
</header>

<main class="wrap">
  {{- if .Errors}}
  <div class="notice" role="alert">
    <svg class="i" aria-hidden="true"><use href="#i-alert"/></svg>
    <div>
      <strong>Analysis incomplete</strong>
      These files could not be analysed, so this result must not be treated as clean:
      <ul>{{range .Errors}}<li>{{.}}</li>{{end}}</ul>
    </div>
  </div>
  {{- end}}

  <section class="overview" aria-labelledby="h-overview">
    <div class="ov-head"><h2 id="h-overview">Findings by severity</h2><span>{{num .Total}} in total</span></div>
    <svg class="dist{{if not .Total}} clean{{end}}" viewBox="0 0 1000 10" preserveAspectRatio="none" role="img" aria-label="{{.DistLabel}}">
      {{- range .Dist}}<rect class="sev-{{.Key}}" x="{{.X}}" y="0" width="{{.W}}" height="10"/>{{end -}}
    </svg>
    <div class="legend">
      {{- range .Counts}}
      <div class="sev-{{.Key}}{{if not .N}} zero{{end}}"><b>{{num .N}}</b><span>{{.Label}}</span></div>
      {{- end}}
    </div>
  </section>

  <section class="block" id="findings" aria-labelledby="h-findings">
    <div class="sec-head">
      <div>
        <h2 id="h-findings">Findings<span class="n" id="findings-count" data-total="{{.Total}}">{{.Total}}</span></h2>
        <p>Grouped by file, most severe first. Findings at or above the threshold start expanded.</p>
      </div>
      {{- if .Groups}}<button type="button" class="btn side" id="toggle-all" hidden>Expand all</button>{{end}}
    </div>
    {{- if .Groups}}
    <div class="toolbar">
      <div class="chips" role="group" aria-label="Filter findings by severity">
        {{- range .Counts}}
        <button type="button" class="chip sev-{{.Key}}{{if not .N}} zero{{end}}" data-sev="{{.Key}}" aria-pressed="true" disabled><b>{{num .N}}</b>{{.Label}}</button>
        {{- end}}
      </div>
      <label class="search" id="search-box" hidden><svg class="i" aria-hidden="true"><use href="#i-search"/></svg><input id="search" type="search" placeholder="Filter by rule, file or text" aria-label="Filter findings" autocomplete="off" spellcheck="false"><kbd>/</kbd></label>
    </div>
    {{- else}}
    <div class="empty"><svg class="i" aria-hidden="true"><use href="#i-ok"/></svg>No findings. Every agent context file was analysed and nothing matched a rule.</div>
    {{- end}}
    <div class="empty" id="no-match" hidden>No findings match the current filter.</div>
    {{- range .Groups}}
    <div class="file">
      <div class="file-head"><span class="path">{{.Path}}</span>{{if .Kind}}<span class="kind">{{.Kind}}</span>{{end}}<span class="tally">{{range .Tally}}<span class="sev-{{.Key}}">{{.N}} {{.Key}}</span>{{end}}</span></div>
      {{- range .Findings}}
      <details class="finding sev-{{.SevKey}}{{if not .Above}} below{{end}}" data-sev="{{.SevKey}}" data-text="{{.Text}}"{{if .Above}} open{{end}}>
        <summary>
          <span class="sev">{{.SevKey}}</span>
          <span class="rule">{{.RuleID}}</span>
          <span class="headline"><span class="title">{{.Title}}</span><span class="msg">{{.Message}}</span></span>
          <span class="loc">Ln {{.Line}}, Col {{.Column}}</span>
          <svg class="i chev" aria-hidden="true"><use href="#i-chev"/></svg>
        </summary>
        <div class="detail">
          {{- if .Excerpt}}
          <pre class="code"><span class="gutter">{{.Line}}</span><code>{{range .Spans}}{{if .Hidden}}<mark class="esc" title="{{.Title}}">{{.Text}}{{if .More}}<span class="more">+{{.More}} more</span>{{end}}</mark>{{else}}{{.Text}}{{end}}{{end}}</code></pre>
          {{- end}}
          <div class="fix"><span class="fix-label">Fix</span><span>{{.Remediation}}</span></div>
          <dl class="facts">
            <div><dt>Confidence</dt><dd>{{.Confidence}}</dd></div>
            {{- if .OWASP}}<div><dt>OWASP</dt><dd>{{range .OWASP}}<span class="tag">{{.}}</span>{{end}}</dd></div>{{end}}
            <div><dt>Fingerprint</dt><dd><span class="fp">{{.Fingerprint}}</span><button class="copy" type="button" data-copy="{{.Fingerprint}}" aria-label="Copy fingerprint" title="Copy fingerprint" hidden><svg class="i i-copy" aria-hidden="true"><use href="#i-copy"/></svg><svg class="i i-check" aria-hidden="true"><use href="#i-check"/></svg></button></dd></div>
            {{- if .DocURL}}<div><a class="doc-link" href="{{.DocURL}}" rel="noreferrer noopener" target="_blank">Rule documentation<svg class="i" aria-hidden="true"><use href="#i-ext"/></svg></a></div>{{end}}
          </dl>
        </div>
      </details>
      {{- end}}
    </div>
    {{- end}}
  </section>

  <section class="block" id="inventory" aria-labelledby="h-inventory">
    <div class="sec-head">
      <div>
        <h2 id="h-inventory">Runs without asking<span class="n">{{len .Inventory}}</span></h2>
        <p>Commands that agents, editors or package managers start on their own: hooks, tasks, install scripts and MCP servers.</p>
      </div>
    </div>
    {{- if .Inventory}}
    <div class="table">
      <table>
        <thead><tr><th>Trigger</th><th>Source</th><th>Name</th><th>Location</th><th>Command</th></tr></thead>
        <tbody>
        {{- range .Inventory}}
          <tr><td><span class="trigger">{{.Trigger}}</span></td><td class="mono">{{.Kind}}</td><td class="mono">{{if .Name}}{{.Name}}{{else}}<span class="muted">—</span>{{end}}</td><td class="mono">{{.Path}}:{{.Line}}</td><td class="cmd"><code>{{.Command}}</code></td></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
    {{- else}}
    <div class="empty"><svg class="i" aria-hidden="true"><use href="#i-ok"/></svg>Nothing in this repository runs automatically.</div>
    {{- end}}
  </section>

  <section class="block" id="files" aria-labelledby="h-files">
    <div class="sec-head">
      <div>
        <h2 id="h-files">Agent context files<span class="n">{{num (len .TargetFiles)}}</span></h2>
        <p>Every file an agent reads or runs that was scanned.</p>
      </div>
    </div>
    {{- if .TargetFiles}}
    {{- if .FoldFiles}}
    <details class="fold">
      <summary><svg class="i chev" aria-hidden="true"><use href="#i-chev"/></svg><span class="when-closed">Show all {{num (len .TargetFiles)}} files</span><span class="when-open">Hide the file list</span></summary>
    {{- end}}
    <div class="table">
      <table>
        <thead><tr><th>File</th><th>Type</th><th class="num">Findings</th></tr></thead>
        <tbody>
        {{- range .TargetFiles}}
          <tr><td class="mono">{{.Path}}</td><td>{{.Kind}}</td><td class="num">{{if .Findings}}<span class="dots">{{range .Severities}}<span class="dot sev-{{.}}"></span>{{end}}</span>{{.Findings}}{{else}}<span class="muted">0</span>{{end}}</td></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
    {{- if .FoldFiles}}
    </details>
    {{- end}}
    {{- else}}
    <div class="empty">No agent context files were found.</div>
    {{- end}}
  </section>

  {{- if .Rules}}
  <section class="block" id="rules" aria-labelledby="h-rules">
    <div class="sec-head">
      <div>
        <h2 id="h-rules">Rules triggered<span class="n">{{len .Rules}}</span></h2>
        <p>Each rule's documentation explains what it detects and why it matters.</p>
      </div>
    </div>
    <div class="table">
      <table>
        <thead><tr><th>Rule</th><th>Title</th><th>Severity</th><th class="num">Findings</th></tr></thead>
        <tbody>
        {{- range .Rules}}
          <tr class="sev-{{.SevKey}}"><td class="mono">{{if .DocURL}}<a href="{{.DocURL}}" rel="noreferrer noopener" target="_blank">{{.ID}}</a>{{else}}{{.ID}}{{end}}</td><td>{{.Title}}</td><td><span class="sev">{{.SevKey}}</span></td><td class="num">{{.Count}}</td></tr>
        {{- end}}
        </tbody>
      </table>
    </div>
  </section>
  {{- end}}
</main>

<footer>
  <div class="wrap">
    <svg aria-hidden="true"><use href="#mark"/></svg>
    <div>
      <p>Generated offline by Portcullis {{.Version}} with rule set {{.Ruleset}}. This report loads nothing from the network; text taken from scanned files is escaped and cannot run.</p>
      <p>Portcullis detects known patterns and structures. A report without findings lowers the risk; it does not prove that a repository is safe.</p>
    </div>
  </div>
</footer>
<script>{{.JS}}</script>
</body>
</html>
